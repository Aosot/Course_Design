@page
@model tools_ctrl_web.Pages.IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>工器具管理系统</title>
    <style>
        body { font-family: 微软雅黑; background: #f0f2f5; margin: 0; }
        .top { background: #001529; color: white; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; }
        .top a { color: #ff7875; text-decoration: none; margin-left: 20px; }
        .container { padding: 50px; text-align: center; }
        .card { display: inline-block; width: 220px; padding: 30px; margin: 20px; border-radius: 12px; color: white; text-decoration: none; }
        .card h2 { margin: 0 0 10px 0; }
        .card p { margin: 0; font-size: 13px; }
        .c1 { background: #1890ff; }
        .c2 { background: #fa8c16; }
        .c3 { background: #ff4d4f; }
    </style>
</head>
<body>
    <div class="top">
        <div>工器具管理系统</div>
        <div>
            <span>欢迎您，@Model.CurrentUser</span>
            <a href="/Logout">退出登录</a>
        </div>
    </div>
    <div class="container">
        <h1>请选择要执行的操作</h1>
        <br />
        <a class="card c1" href="/BR"><h2>借还工器具</h2><p>登记借出与归还</p></a>
        <a class="card c2" href="/RP"><h2>申请维修</h2><p>提交设备维修申请</p></a>
        <a class="card c3" href="/SC"><h2>申报报废</h2><p>上报已损坏设备</p></a>
    </div>
</body>
</html>