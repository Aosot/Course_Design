@page
@model tools_ctrl_web.Pages.BorrowReturnModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>工器具借还</title>
    <style>
            body {
                font-family: 微软雅黑;
                background: #f0f2f5;
                margin: 0;
            }

            .top {
                background: #001529;
                color: white;
                padding: 15px 30px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .top a {
                    color: white;
                    text-decoration: none;
                }

            .container {
                display: flex;
                padding: 20px;
                gap: 20px;
            }

            .left {
                flex: 1;
                background: white;
                border-radius: 10px;
                padding: 15px;
            }

            .right {
                flex: 1;
                background: white;
                border-radius: 10px;
                padding: 20px;
            }

            label {
                display: block;
                margin-top: 12px;
                font-size: 14px;
                color: #333;
            }

            input, select, textarea {
                width: 100%;
                padding: 8px;
                margin-top: 5px;
                border: 1px solid #ddd;
                border-radius: 5px;
                box-sizing: border-box;
            }

            button {
                width: 100%;
                padding: 12px;
                background: #1890ff;
                color: white;
                border: none;
                border-radius: 5px;
                cursor: pointer;
                font-size: 16px;
                margin-top: 20px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
                margin-top: 10px;
            }

            th, td {
                padding: 6px;
                border: 1px solid #eee;
                text-align: left;
            }

            th {
                background: #fafafa;
            }

            .msg {
                color: green;
                text-align: center;
                margin-top: 15px;
            }

            .err {
                color: red;
                text-align: center;
                margin-top: 15px;
            }

            .row {
                display: flex;
                gap: 8px;
                align-items: center;
            }
    </style>
</head>
<body>
    <div class="top">
        <div>工器具借还</div>
        <div><a href="/Index">返回首页</a></div>
    </div>

    <div class="container">
        <div class="left">
            <h3>工器具基础状态信息</h3>
            <label>查询条件：</label>
            <form method="get">
                <select name="FilterStatus" onchange="this.form.submit()">
                    @foreach (var opt in new[] { "全部", "在库", "借出中", "维修中", "已报废" })
                    {
                        if (Model.FilterStatus == opt)
                        {
                            <option value="@opt" selected>@opt</option>
                        }
                        else
                        {
                            <option value="@opt">@opt</option>
                        }
                    }
                </select>
            </form>
            <table>
                <tr><th>工器具编号</th><th>名称</th><th>类别</th><th>资产状态</th></tr>
                @foreach (System.Data.DataRow row in Model.Tools.Rows)
                {
                    <tr>
                        <td>@row["工器具编号"]</td>
                        <td>@row["名称"]</td>
                        <td>@row["类别"]</td>
                        <td>@row["资产状态"]</td>
                    </tr>
                }
            </table>
        </div>

        <div class="right">
            <h3>借还申请</h3>
            <form method="post">
                <label>选择申请类型：</label>
                <select name="Action">
                    <option value="借出">借出</option>
                    <option value="归还">归还</option>
                </select>

                <label>申请人员工编号：</label>
                <input type="text" name="EmployeeId" required />

                <label>工器具编码：</label>
                <input type="text" name="ToolId" required />

                <label>归还日期：</label>
                <div class="row">
                    <input type="text" name="Year" placeholder="年" required />
                    <input type="text" name="Month" placeholder="月" required />
                    <input type="text" name="Day" placeholder="日" required />
                </div>

                <label>所属项目（借出时必填）：</label>
                <input type="text" name="ProjectId" />

                <label>工器具借出去向描述：</label>
                <textarea name="Description" rows="4"></textarea>

                <button type="submit">提交</button>
            </form>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="msg">@Model.Message</div>
            }
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="err">@Model.Error</div>
            }
        </div>
    </div>
</body>
</html>